<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AvaloniaApplicationTestBed.ViewModels"
             x:Class="AvaloniaApplicationTestBed.Views.MainView"
             x:DataType="vm:MainViewModel">

    <!-- Lets the previewer show this view with a real ViewModel -->
    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <StackPanel Spacing="8" Margin="20">
        <TextBlock Text="Biscuits Today" />
        <TextBlock Text="{Binding CountText}" />
        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Ate One" Command="{Binding AddBiscuitCommand}" />
            <Button Content="Reset" Command="{Binding ResetCommand}" />
        </StackPanel>
    </StackPanel>
</UserControl>